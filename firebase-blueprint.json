{
  "entities": {
    "student": {
      "title": "Student",
      "description": "Represents a student in the classroom database",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the student"
        },
        "name": {
          "type": "string",
          "description": "Full name of the student"
        },
        "nis": {
          "type": "string",
          "description": "Student registration number (Nomor Induk Siswa)"
        },
        "gender": {
          "type": "string",
          "enum": ["Laki-laki", "Perempuan"],
          "description": "Gender of the student"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of record creation"
        }
      },
      "required": ["id", "name", "gender", "createdAt"]
    },
    "attendance": {
      "title": "Attendance",
      "description": "Represents a daily attendance record for a student",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique record ID (typically date_studentId)"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Attendance date in YYYY-MM-DD format"
        },
        "studentId": {
          "type": "string",
          "description": "The referenced student ID"
        },
        "status": {
          "type": "string",
          "enum": ["hadir", "alpa", "izin", "sakit"],
          "description": "Attendance status"
        },
        "note": {
          "type": "string",
          "description": "Reason or administrative note for absence"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when this record was last modified"
        },
        "updatedBy": {
          "type": "string",
          "description": "The UID of the user who recorded this attendance"
        }
      },
      "required": ["id", "date", "studentId", "status", "updatedAt", "updatedBy"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "student",
      "description": "Collection of students registered in the class"
    },
    "/attendance/{attendanceId}": {
      "schema": "attendance",
      "description": "Daily attendance entries for students"
    }
  }
}
